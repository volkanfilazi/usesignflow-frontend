# Normalize line endings
* text=auto

# Source files
*.ts text eol=lf
*.html text eol=lf
*.scss text eol=lf
*.css text eol=lf
*.json text eol=lf

# Angular config
angular.json text eol=lf
tsconfig*.json text eol=lf

# Docs
*.md text eol=lf

# Scripts
*.sh text eol=lf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary